+	/**
+	 * Return the Web Library key associated with a portal browser session.
+	 * This internal endpoint avoids listing every key owned by the user while
+	 * keeping the raw credential in Dataserver rather than the portal database.
+	 */
+	public function webUIKey() {
+		$this->allowMethods(['GET']);
+
+		if (!$this->permissions->isSuper()) {
+			$this->e403();
+		}
+
+		$userID = $this->objectUserID;
+		$name = $this->objectName;
+		if (!$userID || !preg_match('/\\A[0-9a-f]{64}\\z/D', $name)) {
+			$this->e400("Invalid Web UI key name");
+		}
+
+		$keyObj = Zotero_Keys::getWebUIKeyByName($userID, $name);
+		if (!$keyObj) {
+			$this->e404("Web UI key not found");
+		}
+
+		header('Content-Type: application/json');
+		echo Zotero_Utilities::formatJSON($keyObj->toJSON([
+			'website' => true,
+			'super' => true,
+			'includeEmails' => false
+		]));
+		$this->end();
+	}
+
