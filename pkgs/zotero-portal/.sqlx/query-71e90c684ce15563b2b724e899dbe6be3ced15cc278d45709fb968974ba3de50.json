  "db_name": "MySQL",
  "query": "SELECT U.userID AS `user_id: UserId`, U.username, U.email, UM.metaValue AS `real_name?` FROM users U LEFT JOIN users_meta UM ON UM.userID = U.userID AND UM.metaKey = 'profile_realname' LEFT JOIN GDN_User GU ON GU.UserID = U.userID WHERE (U.username = ? OR U.email = ?) AND U.role <> 'deleted' AND COALESCE(GU.Banned, 0) = 0 AND EXISTS (SELECT 1 FROM oidc_identities OI WHERE OI.userID = U.userID)",
