  "db_name": "MySQL",
  "query": "SELECT GI.groupID AS `group_id!: u64`, GI.inviteeUserID AS `invitee_user_id: UserId`, U.username, U.email, UM.metaValue AS `real_name?`, DATE_FORMAT(GI.invitedAt, '%Y-%m-%dT%H:%i:%s.%fZ') AS `invited_at!` FROM group_invitations GI JOIN users U ON U.userID = GI.inviteeUserID LEFT JOIN users_meta UM ON UM.userID = U.userID AND UM.metaKey = 'profile_realname' WHERE GI.groupID = ? ORDER BY GI.invitedAt, GI.inviteeUserID",
