diff --git a/src/asset/bundle.rs b/src/asset/bundle.rs
--- a/src/asset/bundle.rs
+++ b/src/asset/bundle.rs
@@ -10 +10 @@
-use crate::common::cargo::{BuildFlags, BuildOpts, Metadata};
+use crate::common::cargo::{BuildError, BuildFlags, BuildOpts, Metadata};
@@ -17,0 +18,7 @@
+    /// Read asset declarations from an existing Cargo artifact
+    #[arg(
+        long,
+        value_name = "PATH",
+        conflicts_with_all = ["bin", "package", "release", "profile"]
+    )]
+    artifact: Option<PathBuf>,
@@ -27,4 +35,11 @@
-    let (exe, bytes) = BuildOpts::from(args.build)
-        .build_and_read(|_, _| {})
